# Plantilla de configuración del backend de StudyFinder.
# Copia este archivo como `.env` y reemplaza los valores. `.env` NO se sube a Git.

# Cadena de conexión a MongoDB.
#   - Atlas: la copias en Atlas > Connect > Drivers (empieza por mongodb+srv://).
#   - Local: mongodb://localhost:27017
# Contiene usuario y contraseña: es un secreto, no la compartas.
# Por defecto: mongodb://localhost:27017
MONGODB_URL=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?appName=<app-name>

# Nombre de la base de datos dentro del servidor MongoDB.
# Por defecto: studyfinder
MONGODB_DATABASE=studyfinder

# Orígenes (URL del frontend) que pueden llamar a la API desde el navegador (CORS),
# separados por comas, sin barra final. En producción pon el dominio real del frontend.
# Por defecto: http://localhost:4200,http://127.0.0.1:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Carpeta donde se guardan los archivos subidos (documentos y adjuntos del chat).
# En Vercel el código es de SOLO LECTURA: usa /tmp/uploads. Ojo: /tmp es efímero y no se
# comparte entre instancias, así que allí los archivos pueden desaparecer.
# Por defecto: carpeta uploads/ en la raíz del backend
# UPLOADS_DIR=/tmp/uploads
